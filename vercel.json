{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/health",
      "destination": "/api"
    },
    {
      "source": "/api/generate-review",
      "destination": "/api"
    }
  ]
}
